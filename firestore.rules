rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'workwithpryielle@gmail.com' && request.auth.token.email_verified == true;
    }
    // v2.3: one check for "may this user act?": not banned, approved by owner, device / IP not banned
    function ok() {
      let d = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return !d.get('banned', false)
        && d.get('approval', 'approved') == 'approved'
        && !(d.get('deviceId', '') != '' && exists(/databases/$(database)/documents/bans/$('d_' + d.get('deviceId', ''))))
        && !(d.get('lastIp', '') != '' && exists(/databases/$(database)/documents/bans/$('ip_' + d.get('lastIp', ''))));
    }
    function notBanned() { return ok(); }
    // new accounts: device must not be banned, and (if the owner keeps this ON) only one account per device
    function deviceFree(devId) {
      let cfg = /databases/$(database)/documents/config/app;
      let own = /databases/$(database)/documents/deviceOwners/$(devId);
      return (exists(cfg) && get(cfg).data.get('oneAccountPerDevice', true) == false)
        || ((!exists(own) || get(own).data.uid == request.auth.uid) && getAfter(own).data.uid == request.auth.uid);
    }
    function deviceGate(d) {
      let devId = d.get('deviceId', '');
      let ip = d.get('lastIp', '');
      return devId is string && devId.size() >= 6 && devId.size() <= 90
        && !exists(/databases/$(database)/documents/bans/$('d_' + devId))
        && (ip == '' || !exists(/databases/$(database)/documents/bans/$('ip_' + ip)))
        && deviceFree(devId);
    }
    function chatOf(id) { return get(/databases/$(database)/documents/chats/$(id)).data; }
    function isMember(id) { return signedIn() && request.auth.uid in chatOf(id).members; }
    function fresh(ms) { return ms > request.time.toMillis() - 600000 && ms < request.time.toMillis() + 600000; }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // v2.10.1: AI settings + Gemini API key — sirf admin padh/likh sakta hai (functions admin SDK se padhte hain)
    match /aiAdmin/{doc} {
      allow read, write: if isAdmin();
    }

    // v2.14: AI Builder. Drafts sirf admin; live packs sabhi approved users padh sakte hain, likh sirf admin sakta hai.
    match /featureDrafts/{id} {
      allow read, write: if isAdmin();
    }
    match /featurePacks/{id} {
      allow read: if isAdmin() || (signedIn() && ok());
      allow write: if isAdmin();
    }

    match /gifs/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /shortcuts/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /notes/{owner} {
      allow read: if signedIn() && ok();
      allow create, update: if signedIn() && request.auth.uid == owner && notBanned();
      allow delete: if signedIn() && request.auth.uid == owner;
    }

    match /news/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /reports/{id} {
      allow create: if signedIn() && notBanned() && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // ---- v2.3 ----
    match /bans/{id} {
      allow get: if signedIn();
      allow list, create, update, delete: if isAdmin();
    }

    match /deviceOwners/{id} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if isAdmin() || (signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.keys().hasOnly(['uid', 'at']));
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // auto-detected bad behaviour; any approved member can raise one (id = chatId_msgId so duplicates are impossible)
    match /alerts/{id} {
      allow create: if signedIn() && ok() && request.resource.data.by == request.auth.uid
        && request.resource.data.text.size() <= 300 && request.resource.data.keys().hasOnly(['kind', 'chatId', 'msgId', 'senderId', 'senderName', 'text', 'matched', 'by', 'at', 'seen']);
      allow read, update, delete: if isAdmin();
    }

    // original text of edited / deleted messages (owner moderation)
    match /audit/{id} {
      allow create: if signedIn() && ok() && request.resource.data.by == request.auth.uid;
      allow read, delete: if isAdmin();
    }

    // APK pieces for the in-app updater
    match /updates/{ver} {
      allow read: if signedIn();
      allow write: if isAdmin();
      match /parts/{pid} {
        allow read: if signedIn();
        allow write: if isAdmin();
      }
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin() || ok());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('pro', false) == false
        && request.resource.data.get('banned', false) == false
        && request.resource.data.get('verified', false) == false
        && request.resource.data.get('role', 'member') == 'member'
        && (isAdmin() || (request.resource.data.get('approval', 'x') == 'pending' && deviceGate(request.resource.data)));
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['banned', 'banReason', 'pro', 'verified', 'role', 'publicId', 'uid', 'approval', 'rejectReason', 'followersCustom', 'followingCustom', 'postsCustom'])
        // posts count sirf +1 badh sakta hai (nayi story par)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['postsCount']) || request.resource.data.postsCount == resource.data.get('postsCount', 0) + 1)
        // device id is locked once set, so it cannot be swapped to dodge a device ban
        && (resource.data.get('deviceId', '') == '' || request.resource.data.get('deviceId', '') == resource.data.get('deviceId', '')));
    }

    // v2.7: emergency alarm. Sirf admin bhejta hai; user sirf ack kar sakta hai.
    match /alarms/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ack', 'ackAt']);
    }

    // v2.5: followers system. id = follower_target
    match /follows/{fid} {
      allow read: if signedIn() && (isAdmin() || ok());
      allow create: if signedIn() && ok()
        && request.resource.data.keys().hasOnly(['follower', 'target', 'at'])
        && request.resource.data.follower == request.auth.uid
        && request.resource.data.target is string
        && request.resource.data.target != request.auth.uid
        && fid == request.auth.uid + '_' + request.resource.data.target;
      allow delete: if signedIn() && (isAdmin() || resource.data.follower == request.auth.uid);
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /publicIds/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
    }

    match /invites/{code} {
      allow read, create: if signedIn();
    }

    match /stories/{owner} {
      allow read: if signedIn() && ok();
      allow create, update: if signedIn() && request.auth.uid == owner && notBanned();
      allow delete: if signedIn() && request.auth.uid == owner;

      match /views/{vid} {
        allow create: if signedIn() && request.resource.data.viewer == request.auth.uid;
        allow read: if signedIn() && (request.auth.uid == owner || resource.data.viewer == request.auth.uid);
      }
      match /media/{mid} {
        allow read: if signedIn() && ok();
        allow write: if signedIn() && request.auth.uid == owner && notBanned();
        match /parts/{pid} {
          allow read: if signedIn() && ok();
          allow create: if signedIn() && request.auth.uid == owner && request.resource.data.d.size() <= 700000;
          allow delete: if signedIn() && request.auth.uid == owner;
        }
      }
    }

    match /chats/{chatId} {
      allow create: if signedIn() && notBanned() && request.auth.uid in request.resource.data.members;
      allow read: if signedIn() && (isAdmin() || resource == null || (request.auth.uid in resource.data.members && ok()));
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
      allow update: if signedIn() && notBanned() && (
        (request.auth.uid in resource.data.members &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastMessage', 'lastAt', 'reads', 'unread', 'typing', 'accepted', 'declined', 'disappearHours']))
        || request.auth.uid in resource.data.admins
        || (resource.data.kind == 'group' &&
            request.auth.uid in request.resource.data.members &&
            request.resource.data.members.hasAll(resource.data.members) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']))
        || (request.auth.uid in resource.data.members &&
            !(request.auth.uid in request.resource.data.members) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins']))
      );

      match /messages/{msgId} {
        allow read: if isAdmin() || (isMember(chatId) && ok());
        allow create: if isMember(chatId) && ok()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'image', 'audio', 'audioMs', 'gif', 'replyTo', 'reactions', 'deleted', 'system', 'createdAt', 'mediaId', 'mediaKind', 'thumb', 'edited'])
          && request.resource.data.senderName.size() <= 40
          && request.resource.data.text.size() <= 2000
          && fresh(request.resource.data.createdAt);
        allow update: if isMember(chatId) && notBanned() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))
          || (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'edited', 'deleted', 'image', 'audio', 'gif', 'mediaId', 'thumb'])
            && request.resource.data.text.size() <= 2000)
          || request.auth.uid in chatOf(chatId).admins
        );
        allow delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }

      match /media/{mid} {
        allow read: if isAdmin() || isMember(chatId);
        allow write: if isMember(chatId) && notBanned();
        match /parts/{pid} {
          allow read: if isAdmin() || isMember(chatId);
          allow create: if isMember(chatId) && notBanned() && request.resource.data.d.size() <= 700000;
          allow delete: if isMember(chatId);
        }
      }
    }
  }
}
